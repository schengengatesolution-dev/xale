generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  name            String
  phone           String?       @unique
  whatsapp        String?
  role            String // SELLER | BUYER
  bankName        String?
  bankAccount     String?
  bankAccountName String?
  createdAt       DateTime      @default(now())
  listings        Listing[]
  reservations    Reservation[]
  settlements     Settlement[]
}

/// Surprise Bag listing (TGTG-style)
model Listing {
  id                   String        @id @default(cuid())
  title                String
  category             String // BAKERY | RESTAURANT | HOTEL | GROCERY | CAFE | FITNESS | OTHER
  description          String
  bagPrice             Int // MNT — Surprise Bag үнэ
  estimatedRetailValue Int // MNT — ойролцоо жижиглэн үнэ
  quantityAvailable    Int
  pickupStart          DateTime
  pickupEnd            DateTime
  pickupDistrict       String
  pickupAddress        String?
  lat                  Float?
  lng                  Float?
  dietaryNotes         String?
  photoUrl             String?
  status               String        @default("ACTIVE") // ACTIVE | SOLD_OUT | HIDDEN | EXPIRED
  sellerId             String
  seller               User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  reservations         Reservation[]
}

/// Buyer reserve → seller mark COLLECTED / NO_SHOW
model Reservation {
  id            String    @id @default(cuid())
  note          String?
  status        String    @default("RESERVED") // RESERVED | COLLECTED | NO_SHOW | CANCELLED
  paymentStatus String    @default("UNPAID") // UNPAID | PENDING | PAID | FAILED | REFUNDED
  paidAt        DateTime?
  amountMnt     Int? // snapshot of bagPrice at pay time
  /// Short redeem code shown to buyer after PAID; seller must enter to mark COLLECTED
  pickupCode    String?   @unique
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payment       Payment?

  @@index([listingId])
  @@index([buyerId])
}

model Payment {
  id              String      @id @default(cuid())
  reservationId   String      @unique
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  qpayInvoiceId   String?     @unique
  senderInvoiceNo String      @unique
  amountMnt       Int
  platformFeeMnt  Int
  sellerAmountMnt Int
  status          String // CREATED | PAID | CANCELLED | FAILED
  qpayPayload     Json?
  urls            Json? // deep links / QR from QPay response
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  settlement      Settlement?
}

/// Recorded on QPay PAID → READY until Thu-cutoff/Fri-payout weekly batch marks PAID_OUT
model Settlement {
  id                String       @id @default(cuid())
  paymentId         String       @unique
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sellerId          String
  seller            User         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amountSellerMnt   Int
  amountPlatformMnt Int
  status            String       @default("READY") // READY | PROCESSING | PAID_OUT | HELD
  payoutTargetDate  DateTime? // legacy; weekly batch uses createdAt + Thursday cutoff
  paidOutAt         DateTime?
  payoutBatchId     String?
  payoutBatch       PayoutBatch? @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  note              String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([payoutBatchId])
  @@index([createdAt])
}

/// Weekly Thu-cutoff / Fri-payout seller batch (manual bank transfer)
model PayoutBatch {
  id             String       @id @default(cuid())
  label          String // e.g. 2026-W39-THU
  cutoffAt       DateTime
  status         String       @default("OPEN") // OPEN | EXPORTED | PAID
  operatorEmail  String?
  operatorNote   String?
  paidAt         DateTime?
  exportedAt     DateTime?
  totalSellerMnt Int          @default(0)
  totalPlatformMnt Int        @default(0)
  sellerCount    Int          @default(0)
  settlementCount Int         @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  settlements    Settlement[]

  @@index([status])
  @@index([cutoffAt])
}

/// Short-lived phone OTP (hashed). One row per phone; overwrite on resend.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
